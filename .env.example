# Production build (`vite build --mode prod`, see the build:prod script). Overrides .env and
# .env.local, so the dev deployments in .env.local are never used by a production build.
# These URLs are public: they end up in the browser's JS anyway.
VITE_SITE_URL=
VITE_CONVEX_URL_US=
VITE_CONVEX_URL_EU=
VITE_CONVEX_URL_AU=
VITE_CONVEX_URL_CA=
